<?xml version="1.0" encoding="utf-8"?>
<!-- Panel card with a single hairline border; colours follow the system theme.
     No rounding: the launcher rounds the bitmap-rendered panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nt_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/nt_hairline" />
</shape>