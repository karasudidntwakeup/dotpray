<?xml version="1.0" encoding="utf-8"?>
<!-- Pure black card with a single hairline border. No rounding: Nothing keeps panels square. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nt_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/nt_hairline" />
</shape>