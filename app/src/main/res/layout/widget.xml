<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="SmallSp">

    <ImageView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_solid" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:minHeight="14dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_red"
                android:importantForAccessibility="no" />

            <ProgressBar
                android:id="@+id/loading_spinner"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/loading_dots"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="NDot55All"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:text="@string/label_next"
                android:textColor="@color/nt_grey_label"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/text_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="NDot55All"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:textScaleX="1.06"
                android:text="@string/prayer_maghrib"
                android:textColor="@color/nt_white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="NDot55All"
                android:includeFontPadding="false"
                android:text="@string/time_placeholder"
                android:textColor="@color/nt_red"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/countdown_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countdown_empty"
                style="@style/CountdownNumber"
                android:text="@string/countdown_placeholder"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/text_countdown"
                style="@style/CountdownNumber"
                android:text="@string/countdown_placeholder" />

            <TextView
                android:id="@+id/text_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/unit_min"
                android:textColor="@color/nt_white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/rail_0"
                style="@style/PrayerRail"
                android:contentDescription="@null"
                android:src="@drawable/rail_track" />

            <ImageView
                android:id="@+id/rail_1"
                style="@style/PrayerRail"
                android:contentDescription="@null"
                android:src="@drawable/rail_track" />

            <ImageView
                android:id="@+id/rail_2"
                style="@style/PrayerRail"
                android:contentDescription="@null"
                android:src="@drawable/rail_track" />

            <ImageView
                android:id="@+id/rail_3"
                style="@style/PrayerRail"
                android:contentDescription="@null"
                android:src="@drawable/rail_track" />

            <ImageView
                android:id="@+id/rail_4"
                style="@style/PrayerRail"
                android:contentDescription="@null"
                android:src="@drawable/rail_track" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/PrayerColumn">
                <TextView
                    android:id="@+id/row_name_0"
                    style="@style/PrayerRowName"
                    android:text="@string/prayer_fajr" />

                <TextView
                    android:id="@+id/row_time_0"
                    style="@style/PrayerRowTime"
                    android:text="@string/time_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/PrayerColumn">
                <TextView
                    android:id="@+id/row_name_1"
                    style="@style/PrayerRowName"
                    android:text="@string/prayer_dhuhr" />

                <TextView
                    android:id="@+id/row_time_1"
                    style="@style/PrayerRowTime"
                    android:text="@string/time_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/PrayerColumn">
                <TextView
                    android:id="@+id/row_name_2"
                    style="@style/PrayerRowName"
                    android:text="@string/prayer_asr" />

                <TextView
                    android:id="@+id/row_time_2"
                    style="@style/PrayerRowTime"
                    android:text="@string/time_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/PrayerColumn">
                <TextView
                    android:id="@+id/row_name_3"
                    style="@style/PrayerRowName"
                    android:text="@string/prayer_maghrib" />

                <TextView
                    android:id="@+id/row_time_3"
                    style="@style/PrayerRowTime"
                    android:text="@string/time_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/PrayerColumn">
                <TextView
                    android:id="@+id/row_name_4"
                    style="@style/PrayerRowName"
                    android:text="@string/prayer_isha" />

                <TextView
                    android:id="@+id/row_time_4"
                    style="@style/PrayerRowTime"
                    android:text="@string/time_placeholder" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
