<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer notification body: the same dot face and monochrome ink as the
     widget. SystemUI supplies the surrounding card and header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    tools:ignore="SmallSp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="NDot55All"
            android:includeFontPadding="false"
            android:letterSpacing="0.22"
            android:text="@string/notification_label"
            android:textColor="@color/nt_grey_label"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/notification_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="NDot55All"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="@string/prayer_dhuhr"
            android:textColor="@color/nt_white"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="NDot55All"
        android:includeFontPadding="false"
        android:text="@string/time_placeholder"
        android:textColor="@color/nt_red"
        android:textSize="16sp" />
</LinearLayout>
