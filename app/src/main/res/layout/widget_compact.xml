<?xml version="1.0" encoding="utf-8"?>
<!-- Compact head: countdown, the next prayer, the bar. For small cells. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_solid">

    <!-- Rendered with the launcher's corner radius; covers the preview background. -->
    <ImageView
        android:id="@+id/panel_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/label_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="--"
            android:textColor="@color/nt_grey_meta"
            android:textSize="9sp" />

        <Chronometer
            android:id="@+id/text_countdown"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/ndot57"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="--:--"
            android:textColor="@color/nt_white"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_prayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ndot55"
                android:includeFontPadding="false"
                android:text="MAGHRIB"
                android:textColor="@color/nt_white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ndot57"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/nt_white"
                android:textSize="17sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY" />

        <!-- All five times, when the cell is tall enough to hold them. -->
        <LinearLayout
            android:id="@+id/times_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_time_0"
                style="@style/CompactTime"
                android:text="00:00" />

            <TextView
                android:id="@+id/row_time_1"
                style="@style/CompactTime"
                android:text="00:00" />

            <TextView
                android:id="@+id/row_time_2"
                style="@style/CompactTime"
                android:text="00:00" />

            <TextView
                android:id="@+id/row_time_3"
                style="@style/CompactTime"
                android:text="00:00" />

            <TextView
                android:id="@+id/row_time_4"
                style="@style/CompactTime"
                android:text="00:00" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
