<?xml version="1.0" encoding="utf-8"?>
<!-- The widget stores only a cached location and schedule; nothing needs to
     leave the device. This mirrors android:allowBackup="false" for API 31+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
