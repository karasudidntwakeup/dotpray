<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Five prayer columns on the large widget. -->
    <style name="PrayerColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PrayerRowName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nt_grey_label</item>
        <item name="android:textSize">8sp</item>
    </style>

    <style name="PrayerRowTime">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nt_grey_future</item>
        <item name="android:textScaleX">1.08</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="CountdownNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">NDot55All</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nt_white</item>
        <item name="android:textSize">50sp</item>
    </style>

    <style name="PrayerRail">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitXY</item>
    </style>
</resources>
